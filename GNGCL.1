CREATE TABLE Supplier (
    supplier_id INT,
    supplier_name VARCHAR(50),
    contact VARCHAR(20)
);

-- Product Table
CREATE TABLE Product (
    product_id INT,
    product_name VARCHAR(50),
    supplier_id INT,
    quantity INT,
    price DECIMAL(10,2)
);

CREATE TABLE Supply_Log (
    log_id INT,
    product_id INT,
    quantity_supplied INT
);



